# ==============================================================================
# CoreCraftr Environment Configuration (Example)
# Copy this file to .env and replace placeholders with your local values.
# NEVER commit your real .env file to version control.
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Database Configuration (PostgreSQL recommended)
# Set DB_ENGINE=postgresql for PostgreSQL, or sqlite for local fallback/testing
DB_ENGINE=postgresql
DB_NAME=corecraftr_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Email Configuration (use console backend in local development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=replace-with-app-password
DEFAULT_FROM_EMAIL=noreply@corecraftr.local

# AI Integration (Optional - deterministic fallback activates automatically if unset)
# Supported providers: none | openai | gemini
AI_PROVIDER=none
AI_API_KEY=replace-with-your-ai-api-key
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=15
